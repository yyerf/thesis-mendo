# MendoVendo v3.0 — environment configuration
# Copy to .env and adjust for your deployment.

# ── Flask ──
# Random hex string used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
MENDO_SECRET_KEY=

# Set to "true" when serving behind HTTPS (kiosk builds)
# MENDO_HTTPS=false

# ── Semantic backend ──
# Which engine powers the semantic fallback stage:
#   "sailor" (default) → local LLM (Sailor2) served by Ollama on this device
#   "minilm"           → sentence-transformers baseline (MiniLM, benchmark only)
MENDO_SEMANTIC_BACKEND=sailor

# Ollama endpoint + model (used only when MENDO_SEMANTIC_BACKEND=sailor).
# Model runs on-device; patient data never leaves the device (RA 10173).
MENDO_LLM_URL=http://127.0.0.1:11434
MENDO_LLM_MODEL=sailor2:1b
MENDO_LLM_TIMEOUT=60

# MiniLM device (only when MENDO_SEMANTIC_BACKEND=minilm)
# MENDO_SEMANTIC_DEVICE=cpu

# ── Xendit cashless payments (optional) ──
# XENDIT_SECRET_KEY=
# XENDIT_WEBHOOK_TOKEN=
