module rounded_rect_2d(l, w, r) {
    offset(r=r) square([l - 2*r, w - 2*r], center=true);
}

module rotor() {
    difference() {
        linear_extrude(height=rotor_thickness) polygon(points=gear_outline);
        translate([0, 0, -0.5])
        linear_extrude(height=rotor_thickness + 1.0) {
            circle(d=center_bore_d, $fn=96);
            for (i=[0:3])
                rotate(i*90 + 45) translate([bolt_circle_d/2, 0])
                    circle(d=bolt_hole_d, $fn=48);
            for (i=[0:pocket_count-1])
                rotate(i*360/pocket_count) translate([pocket_radius, 0])
                    rounded_rect_2d(pocket_length, pocket_width, pocket_corner_radius);
        }
    }
}

rotor();
