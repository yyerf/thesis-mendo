{% extends 'base.html' %}
{% set title = 'Mendo | Assessment' %}

{% block content %}
<section class="pos">
  <div class="pos__header">
    <div>
      <div class="pos__title">Assessment</div>
      <div class="pos__subtitle muted">Age: {{ age }} • Input: {{ text }}</div>
    </div>
    <div class="pos__actions">
      <button class="btn" type="button" onclick="window.print()">Print</button>
      <a class="btn btn--primary" href="{{ url_for('nlp') }}">New Assessment</a>
    </div>
  </div>

  {% if not ok %}
    <div class="pos__card pos__card--warn">
      <div class="pos__cardTitle">Error</div>
      <div class="muted">{{ error }}</div>
    </div>
  {% else %}
    {% if clarify and clarify.needed %}
      <div class="pos__card pos__card--warn">
        <div class="pos__cardTitle">Clarification</div>
        <div class="muted">{{ clarify.question }}</div>
        <form class="pos__row" method="post" action="{{ url_for('nlp_results') }}" target="_self">
          <input type="hidden" name="text" value="{{ text }}" />
          <input type="hidden" name="age" value="{{ age }}" />
          <button class="btn btn--primary" type="submit" name="cough_type" value="dry">Dry (walay/walang plema)</button>
          <button class="btn" type="submit" name="cough_type" value="productive">With plema (naay/may plema)</button>
        </form>
      </div>
    {% endif %}

    <div class="pos__grid">
      <div class="pos__card">
        <div class="pos__cardTitle">Detected Symptoms</div>
        <div class="chips">
          {% if detected and detected|length > 0 %}
            {% for s in detected %}
              <div class="chip chip--ok">{{ s }}</div>
            {% endfor %}
          {% else %}
            <div class="chip chip--warn">None</div>
          {% endif %}
        </div>
      </div>

      <div class="pos__card">
        <div class="pos__cardTitle">Recommendations</div>
        {% if recommendations and recommendations|length > 0 %}
          <div class="recs">
            {% for r in recommendations %}
              <div class="rec">
                <div class="rec__title">
                  <div class="rec__name">{{ r.brand }}</div>
                  <div class="rec__meta">Min age: {{ r.min_age }}{% if r.dosage_form %} • {{ r.dosage_form }}{% endif %}</div>
                </div>
                <div class="rec__why">
                  <div><strong>Active:</strong> {{ r.active_ingredients }}</div>
                  <div class="muted" style="margin-top:6px;">{{ r.reason }}</div>
                </div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="muted">No recommendations yet.</div>
        {% endif %}
      </div>
    </div>
  {% endif %}
</section>
{% endblock %}
