{% extends 'base.html' %}
{% set title = 'Mendo | Home' %}

{% block content %}
<section class="hero">
  <div class="hero__card">
    <div class="badge">Prototype</div>
    <h1>Mixed-language Symptom → OTC Recommendation</h1>
    <p class="muted">
      Supports Tagalog, Bisaya, English, and Taglish/Conyo.
      Uses a hybrid pipeline: deterministic dictionary first, semantic fallback when needed.
    </p>

    <div class="actions">
      <a class="btn btn--primary" href="{{ url_for('nlp') }}">Start Symptom Check</a>
      <a class="btn" href="{{ url_for('disclaimer') }}">Disclaimer</a>
    </div>

    <div class="grid grid--3">
      <div class="tile">
        <div class="tile__k">Dictionary</div>
        <div class="tile__v">Fast & deterministic</div>
        <div class="tile__s">Handles negation + qualifiers (e.g., “walay plema”).</div>
      </div>
      <div class="tile">
        <div class="tile__k">Embeddings</div>
        <div class="tile__v">Semantic match</div>
        <div class="tile__s">Catches paraphrases like “head exploding”.</div>
      </div>
      <div class="tile">
        <div class="tile__k">Explainable</div>
        <div class="tile__v">Panel-friendly</div>
        <div class="tile__s">Shows why each medicine is recommended.</div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
